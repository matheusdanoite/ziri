<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>fi.ziri.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__ZIRI_BIN__</string>
        <string>serve</string>
        <string>--interval</string>
        <string>5</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.ziri/ziri.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.ziri/ziri.log</string>

    <!-- Sem janela, sem ícone no Dock: o daemon é invisível. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
