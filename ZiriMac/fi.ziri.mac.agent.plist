<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Registrado pelo próprio ziri.app via SMAppService.agent. -->
    <key>Label</key>
    <string>fi.ziri.mac.agent</string>

    <key>BundleProgram</key>
    <string>Contents/MacOS/ziri</string>

    <key>RunAtLoad</key>
    <true/>
    <!-- Volta se cair; uma saída limpa (exit 0) fica parada. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
